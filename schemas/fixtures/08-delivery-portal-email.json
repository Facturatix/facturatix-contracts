{
  "schema_version": 2,
  "variables": [
    { "name": "rfc", "source": "user.fiscal.rfc", "required": true },
    { "name": "email_fiscal", "source": "user.fiscal.email", "required": true }
  ],
  "actions": [
    { "id": "open", "action": "goto", "url": "https://facturacion.comercio.mx/" },
    {
      "id": "fill-rfc",
      "action": "fill",
      "locator": { "strategy": "role", "role": "textbox", "name": "RFC" },
      "value": "{{rfc}}"
    },
    {
      "id": "fill-email",
      "action": "fill",
      "locator": { "strategy": "label", "value": "Correo de facturación" },
      "value": "{{email_fiscal}}"
    },
    {
      "id": "submit",
      "action": "click",
      "locator": { "strategy": "role", "role": "button", "name": "Enviar por correo" }
    }
  ],
  "edges": [
    { "from": "open", "to": "fill-rfc" },
    { "from": "fill-rfc", "to": "fill-email" },
    { "from": "fill-email", "to": "submit" }
  ],
  "completion": {
    "mode": "all",
    "assertions": [
      {
        "type": "selector_text",
        "locator": { "strategy": "css", "value": ".aviso-envio" },
        "contains": "enviamos tu factura al correo"
      }
    ],
    "delivery": {
      "mode": "portal_email",
      "destination_binding": "user.fiscal.email"
    }
  }
}
