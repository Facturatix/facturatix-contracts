{
  "schema_version": 2,
  "variables": [
    { "name": "sucursal", "source": "ticket.extracted.sucursal", "required": true },
    { "name": "folio", "source": "ticket.extracted.folio", "required": true }
  ],
  "actions": [
    { "id": "open", "action": "goto", "url": "https://facturacion.comercio.mx/" },
    {
      "id": "choose-branch",
      "action": "select",
      "locator": { "strategy": "role", "role": "combobox", "name": "SUCURSAL" },
      "value": "{{sucursal}}",
      "options": [
        { "value": "61", "label": "CAMPUS" },
        { "value": "61", "label": "CAMPUS NORTE" },
        { "value": "62" }
      ]
    },
    {
      "id": "type-folio",
      "action": "fill",
      "locator": { "strategy": "role", "role": "textbox", "name": "FOLIO" },
      "value": "{{folio}}",
      "options": [{ "value": "A-1", "label": "A-1" }]
    }
  ],
  "edges": [
    { "from": "open", "to": "choose-branch" },
    { "from": "choose-branch", "to": "type-folio" }
  ],
  "completion": {
    "assertions": [{ "type": "url_matches", "pattern": "/confirmacion" }]
  }
}
