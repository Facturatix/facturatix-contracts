<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 only. Both consumers (facturatix-api and facturatix-generator) are net10.0, and
      targeting the framework directly is what lets the recipe validator and the RFC 8785
      canonicalizer use System.Text.Json without adding a single package dependency to a package
      whose whole purpose is to be a dependency. The 1.x line targeted netstandard2.0; dropping
      that target is part of the 2.0.0 major bump.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Package identity -->
    <PackageId>Facturatix.Contracts</PackageId>
    <RootNamespace>Facturatix.Contracts</RootNamespace>
    <AssemblyName>Facturatix.Contracts</AssemblyName>

    <!--
      Versioning: managed by CI/CD. 2.0.0 introduced the recipe execution contract v2; 2.0.1 makes
      the TypeScript canonicalizer refuse values with no JSON representation instead of emitting
      `null` for them — a hash the API could never reproduce. The npm twin (@facturatix/contracts)
      publishes from the same commit with the same version, so one number identifies the contract in
      both ecosystems.
    -->
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>

    <!-- NuGet package metadata -->
    <Authors>Facturatix</Authors>
    <Company>Facturatix</Company>
    <Description>Canonical contracts for the Facturatix platform: the recipe execution schema v2 with its reference validator and RFC 8785 canonical hash, machine-readable API error codes, and shared status constants. Consumed by facturatix-api and facturatix-generator; the TypeScript twin ships as @facturatix/contracts.</Description>
    <PackageTags>facturatix;contracts;shared;constants;json-schema</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Facturatix/facturatix-contracts</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      SourceLink for debugging into package source. There is no PackageReference: the .NET SDK
      has carried the SourceLink targets since .NET 8, so a project targeting net10.0 gets them
      from the SDK, and the properties below are all the opt-in it needs (the packed .nuspec
      carries <repository commit="..."> and obj/<config>/net10.0/*.sourcelink.json is generated,
      which is how this was verified).

      The explicit Microsoft.SourceLink.GitHub 8.0.0 reference was removed on 2026-09-09: it drags
      in Microsoft.Build.Tasks.Git 8.0.0, which CVE-2026-62900 (GHSA-23fw-v26w-5fgq, published
      2026-09-08) marks vulnerable with NO patched 8.x release, so NuGetAudit raised NU1902 and
      TreatWarningsAsErrors turned it into a restore error on every build. Do not add the package
      back; if a future SDK ever stops bundling SourceLink, reference 10.0.401 or newer, never 8.0.0.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Include README in the NuGet package -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The schema and the fixtures ship two ways on purpose.

    EmbeddedResource is what consumers read at runtime through RecipeContractResources. It cannot be
    defeated by a missing copy-to-output step, so a contract test can never go green by silently
    finding zero fixtures — the failure mode that makes a "gate" decorative.

    contentFiles puts the same files on disk next to the consuming project, which is what editors
    and JSON Schema tooling need to resolve the schema without running code.

    The logical name normalizes %(RecursiveDir) to forward slashes. On Windows MSBuild yields
    "fixtures\" and the resource would be embedded as "schemas/fixtures\manifest.json", which
    RecipeContractResources — and every consumer's fixture gate — looks up with "/". CI builds on
    Linux never hit this, so a package packed locally to test a contract change before publishing
    silently shipped fixtures nothing could read.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/**/*.json"
                      LogicalName="schemas/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <Content Include="../../schemas/**/*.json"
             Pack="true"
             PackagePath="contentFiles/any/net10.0/schemas/%(RecursiveDir)"
             PackageCopyToOutput="true"
             CopyToOutputDirectory="PreserveNewest"
             Link="schemas/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
