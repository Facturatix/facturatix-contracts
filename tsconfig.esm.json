{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ESM twin of the CommonJS build. Bundlers (Vite, Rollup, webpack) can statically analyse
    // `export *` here; they cannot do that through TypeScript's CommonJS `__createBinding` output,
    // which is why a CJS-only package failed to build inside the Electron renderer.
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "dist/esm"
  }
}
